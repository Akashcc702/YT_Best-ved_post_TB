# ===== Telegram =====
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
TELEGRAM_CHANNEL_ID=@your_channel_username_or_-100xxxxxxxxxx
# Comma-separated numeric Telegram user IDs allowed to use admin commands (/search, /settings)
TELEGRAM_ADMIN_IDS=111111111,222222222

# ===== YouTube search — via Invidious (free, keyless, no daily quota) =====
# Comma-separated list of Invidious instance base URLs, tried in order with
# automatic failover if one is down/rate-limited. No API key or Google
# account needed. Check https://api.invidious.io/ for a live list of public
# instances if these defaults ever stop responding, and consider putting a
# self-hosted instance first for reliability (self-hosting is free too).
INVIDIOUS_INSTANCES=https://invidious.jing.rocks,https://yewtu.be,https://invidious.nerdvpn.de,https://inv.nadeko.net

# ===== AI ranking backend: "openrouter" or "gemini" =====
AI_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys) — openrouter/free auto-picks a free model for you;
# or set a specific model whose name ends in ":free" instead if you want a fixed one
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free

# Gemini (https://aistudio.google.com/apikey) — used only if AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ===== App behaviour =====
# IANA timezone for the daily schedule
SCHEDULE_TIMEZONE=Asia/Kolkata
# Time to run the daily digest, 24h HH:MM in SCHEDULE_TIMEZONE
SCHEDULE_TIME=09:00
# How many top videos to select and post
TOP_N=3
# Max candidate videos pulled from search before filtering/ranking
SEARCH_MAX_CANDIDATES=40
# Comma separated search queries run every day (each is a search term sent to Invidious)
SEARCH_QUERIES=AI automation tutorial,python project tutorial,local AI ollama tutorial,LLM agent tutorial,open source AI tools tutorial,docker tutorial,RAG tutorial,n8n automation tutorial

# ===== Web server (Render binds $PORT) =====
PORT=10000
# Public base URL of the deployed Render service, used to register the Telegram webhook
PUBLIC_BASE_URL=https://your-service-name.onrender.com
# Random secret path segment for the webhook route, keep this private
WEBHOOK_SECRET=change-me-to-a-random-string

# ===== Database =====
DATABASE_PATH=./data/app.db

# ===== Logging =====
LOG_LEVEL=INFO
